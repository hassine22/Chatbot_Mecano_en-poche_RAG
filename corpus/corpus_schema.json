{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Passage du corpus Mécano de poche",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "marque", "modele", "phase", "annees", "langue", "chapitre", "section",
               "sous_section", "titre", "categorie", "pages", "texte", "texte_embedding",
               "nb_mots", "document", "source_url"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+-[0-9]{3}$"},
    "marque": {"type": "string", "minLength": 2},
    "modele": {"type": "string", "minLength": 1},
    "phase": {"type": "string"},
    "annees": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$"},
    "langue": {"enum": ["fr", "en", "ar"]},
    "chapitre": {"type": "string", "minLength": 1},
    "section": {"type": "string", "minLength": 1},
    "sous_section": {"type": ["string", "null"]},
    "titre": {"type": "string", "minLength": 1},
    "categorie": {"enum": ["voyant", "message_tableau_de_bord", "anomalie", "demarrage_moteur",
                           "aides_conduite", "boite_automatique", "direction", "carburant",
                           "entretien", "pneus_roues", "fusibles", "electricite_batterie",
                           "remorquage", "identification", "caracteristiques_moteur", "code_obd"]},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "texte": {"type": "string", "minLength": 20},
    "texte_embedding": {"type": "string", "minLength": 20},
    "nb_mots": {"type": "integer", "minimum": 1},
    "document": {"type": "string", "minLength": 3},
    "source_url": {"type": "string", "pattern": "^https?://"}
  }
}
